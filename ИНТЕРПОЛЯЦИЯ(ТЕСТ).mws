> # построение ИМ Лагранжа для функции F(x)
> Lagr:=proc(n, X, F)
>     local i, j, Sm, P, Lg;
>     Sm:=0:
>     for i from 0 to n do 
>         P:=1:
>         for j from 0 to n do 
>             if j<>i then 
>                 # Формула полинома: (x - x_j) / (x_i - x_j)
>                 P:=P*(x - X[j]) / (X[i] - X[j]); 
>             end if: 
>         end do:
>         # Суммирование значений функции, домноженных на базисные полиномы 
>         Sm:=Sm + F[i]*P: 
>     end do:
>     Lg:=simplify(Sm);
>     return(Lg);
>   end proc;

  Lagr := proc(n, X, F)
local i, j, Sm, P, Lg;
    Sm := 0;
    for i from 0 to n do
        P := 1;
        for j from 0 to n do
            if j <> i then P := P*(x - X[j])/(X[i] - X[j])
            end if
        end do;
        Sm := Sm + F[i]*P
    end do;
    Lg := simplify(Sm);
    return Lg
end proc

> # Вызов процедуры
